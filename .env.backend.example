ENV=development
APP_PORT=1405
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=camai
TOKEN_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MEDIA_PORT=1406
MEDIA_PUBLIC_URL=http://localhost:1406
MEDIA_SECRET=

# S3-compatible private storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=camai-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

AI_PROVIDER_A_KEY=
AI_PROVIDER_B_KEY=
AI_DAILY_QUOTA=20
